# Streamlit secrets template.
#
# Local dev: copy to .streamlit/secrets.toml (already gitignored) and fill in.
# Streamlit Cloud: paste these into the app dashboard's Secrets pane.
#
# Panel falls back to mock responses when no key is present — the demo still
# flows. Adding a real key lights up the corresponding provider.

# --- LLM provider keys (pick one or more) -----------------------------------

# Anthropic — required for image OCR (Claude vision). $5 in credits goes far.
ANTHROPIC_API_KEY = "sk-ant-..."

# Google AI Studio — free tier, no card required. Best for shared demos.
GEMINI_API_KEY = "AIza..."

# OpenAI — optional.
OPENAI_API_KEY = "sk-..."

# LM Studio — local model; only meaningful when running on a machine
# that hosts LM Studio. Skip on Streamlit Cloud.
LMSTUDIO_URL = "http://localhost:1234/v1/chat/completions"

# --- Behaviour ---------------------------------------------------------------

# Force a specific provider regardless of UI choice. Options:
#   claude_cli | anthropic | openai | gemini | lmstudio | mock
# Leave unset to let the user pick in the sidebar.
# PANEL_LLM_PROVIDER = "anthropic"

# Disable on-disk result cache (1 = enabled, 0 = disabled). Default: 1.
PANEL_CACHE = "1"
